# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL in staging and production, SQLite allowed for local development)
DATABASE_URL=sqlite:///./local_development.sqlite3

# Authentication
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# AI model provider
ANTHROPIC_API_KEY=
AI_MODEL_NAME=

# File storage (S3-compatible)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=

# Environment: development, staging or production
APPLICATION_ENVIRONMENT=development

# Rate limiting (defaults shown)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
REGISTRATION_MAX_PER_HOUR=10
# How many reverse proxies sit in front of the server. Keep 0 unless you run behind a proxy you control.
TRUSTED_PROXY_COUNT=0
